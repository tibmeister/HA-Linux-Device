[Unit]
Description=MQTT Data Writer Service
After=network.target

[Service]
ExecStart=/usr/local/bin/mqtt-app
Restart=always
User=nobody
Group=nogroup
EnvironmentFile=/etc/mqtt-app.conf
WorkingDirectory=/usr/local/bin
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=mqtt-app

[Install]
WantedBy=multi-user.target
